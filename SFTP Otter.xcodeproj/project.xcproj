{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "packages": [
    {
      "kind": "remote",
      "repository": "https://github.com/TopScrech/ScrechKit",
      "version": {
        "up-to-next-major-version": "1.0.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/TopScrech/Citadel",
      "version": {
        "branch": "main",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/apple/swift-nio",
      "version": {
        "up-to-next-major-version": "2.81.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/Wellz26/swift-nio-ssh",
      "version": {
        "up-to-next-minor-version": "0.3.4",
      },
    },
  ],
  "files": [
    { "path": "README.md" },
    { "path": "AGENTS.md" },
    {
      "kind": "folder",
      "path": "Shared",
      "target-membership": [
        "iOS",
        "macOS",
      ],
      "membership-exceptions": [
        {
          "target": "Unit Tests",
          "inclusions": [
            "Connection/CitadelSFTPTransport.swift",
            "Connection/ConnectionError.swift",
            "Connection/HostKeyChallenge.swift",
            "Connection/HostKeyTrustStore.swift",
            "Connection/RemoteFileHandle.swift",
            "Connection/SFTPConnectionError.swift",
            "Connection/SFTPSession.swift",
            "Connection/SFTPTransport.swift",
            "Connection/SSHNegotiationLogger.swift",
            "Connection/ServerKeyValidator.swift",
            "Connection/TransferDiskFile.swift",
            "Connection/TransferGate.swift",
            "Connection/TransferPipeline.swift",
            "Design/DialogActionStyle.swift",
            "Design/WorkspaceDialogContentView.swift",
            "Design/WorkspaceDialogView.swift",
            "Design/WorkspaceTheme.swift",
            "Files/BrowserActionsNavigation.swift",
            "Files/BrowserPane.swift",
            "Files/FileSelection.swift",
            "Files/FileSortColumn.swift",
            "Files/FileSortOrder.swift",
            "Files/LocalFileBrowserModel.swift",
            "Files/LocalFileOperations.swift",
            "Files/RemoteFile.swift",
            "Hosts/Host.swift",
            "Hosts/HostStore.swift",
            "Hosts/KeychainHostData.swift",
            "Hosts/KeychainStoreError.swift",
            "Transfers/CombinedTransferProgress.swift",
            "Transfers/DirectoryDownload.swift",
            "Transfers/DownloadExporter.swift",
            "Transfers/DownloadTreeEntry.swift",
            "Transfers/FileTransfer.swift",
            "Transfers/FolderTransferProgress.swift",
            "Transfers/FolderUploadFile.swift",
            "Transfers/QueuedUpload.swift",
            "Transfers/TransferPreferences.swift",
            "Transfers/TransferState.swift",
            "Transfers/UploadConflict.swift",
            "Transfers/UploadConflictChoice.swift",
            "Transfers/UploadQueue.swift",
            "Transfers/UploadSource.swift",
          ],
        },
      ],
    }, {
      "kind": "folder",
      "path": "macOS",
      "target-membership": [
        "macOS",
      ],
      "membership-exceptions": [
        {
          "target": "macOS",
          "exclusions": [
            "SFTP-Otter.plist",
          ],
        }, {
          "target": "Unit Tests",
          "inclusions": [
            "Files/FileActionError.swift",
            "Files/FileActionsModel+Preview.swift",
            "Files/FileActionsModel+Selection.swift",
            "Files/FileActionsModel.swift",
            "Files/FileContextMenuView.swift",
            "Files/FileDragPromise.swift",
            "Files/FileMenuAction.swift",
            "Files/FileMenuButtonView.swift",
            "Files/FileMenuNavigation.swift",
            "Files/PermissionAccess.swift",
            "Files/PermissionAccessRowView.swift",
            "Files/PermissionToggleStyle.swift",
            "Files/PermissionsEditorView.swift",
            "Files/QuickLookCache.swift",
            "Files/QuickLookCacheEntry.swift",
          ],
        },
      ],
    },
    { "kind": "folder", "path": "Tests", "target-membership": [ "Unit Tests" ] },
    { "kind": "folder", "path": "iOS", "target-membership": [ "iOS" ] },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/macOS.app", "id": "000000000000000000000120", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/Unit Tests.xctest", "id": "DD0000000000000000000001", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/iOS.app", "id": "F3981994305F31A8004F04A9", "type": "wrapper.application", "index": false },
      ],
    },
  ],
  "targets": [
    {
      "name": "macOS",
      "id": "000000000000000100000000",
      "product": "Products/macOS.app",
      "product-type": "application",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "package-product-members": [
        {
          "package": "Citadel",
          "product-name": "Citadel",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "ScrechKit",
          "product-name": "ScrechKit",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "swift-nio",
          "product-name": "NIOCore",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "swift-nio",
          "product-name": "NIOPosix",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "swift-nio-ssh",
          "product-name": "NIOSSH",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "CODE_SIGN_IDENTITY": "Apple Development",
        "CODE_SIGN_STYLE": "Automatic",
        "ENABLE_APP_SANDBOX": "YES",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "ENABLE_INCOMING_NETWORK_CONNECTIONS": "NO",
        "ENABLE_OUTGOING_NETWORK_CONNECTIONS": "YES",
        "ENABLE_PREVIEWS": "YES",
        "ENABLE_RESOURCE_ACCESS_AUDIO_INPUT": "NO",
        "ENABLE_RESOURCE_ACCESS_BLUETOOTH": "NO",
        "ENABLE_RESOURCE_ACCESS_CALENDARS": "NO",
        "ENABLE_RESOURCE_ACCESS_CAMERA": "NO",
        "ENABLE_RESOURCE_ACCESS_CONTACTS": "NO",
        "ENABLE_RESOURCE_ACCESS_LOCATION": "NO",
        "ENABLE_RESOURCE_ACCESS_PRINTING": "NO",
        "ENABLE_RESOURCE_ACCESS_USB": "NO",
        "ENABLE_USER_SELECTED_FILES": "readwrite",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "macOS/SFTP-Otter.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "SFTP Otter",
        "INFOPLIST_KEY_ITSAppUsesNonExemptEncryption": "NO",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.developer-tools",
        "INFOPLIST_KEY_NSLocalNetworkUsageDescription": "Connect to SFTP servers on your local network",
        "LD_RUNPATH_SEARCH_PATHS": "@executable_path/../Frameworks",
        "LM_SKIP_METADATA_EXTRACTION": "YES",
        "MACOSX_DEPLOYMENT_TARGET": "26",
        "PRODUCT_BUNDLE_IDENTIFIER": "dev.topscrech.SFTP-Otter",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "PROVISIONING_PROFILE_SPECIFIER": "",
        "REGISTER_APP_GROUPS": "YES",
        "SDKROOT": "macosx",
        "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
        "SUPPORTED_PLATFORMS": "macosx",
        "SUPPORTS_MACCATALYST": "NO",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
        "SWIFT_VERSION": "6.0",
      },
    }, {
      "name": "Unit Tests",
      "id": "DD0000000000000000000009",
      "product": "Products/Unit Tests.xctest",
      "product-type": "bundle.unit-test",
      "build-phases": [
        "compile-sources",
        "frameworks",
      ],
